PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/property-finder
JWT_SECRET=replace-with-a-long-random-string
OLLAMA_BASE_URL=https://ollama.cognaitive.in
# Prefer local for speed: OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PREDICT=384
OLLAMA_TEMPERATURE=0.6
